# =========================
# 📦 Dependencies
# =========================
node_modules/
# Installed npm packages (very large, should never be pushed)

# =========================
# 🔐 Environment Variables
# =========================
.env
.env.*
# Contains secrets like API keys, DB passwords

# =========================
# 🛠 Build / Output Files
# =========================
dist/
build/
out/
# Compiled or production build files

# =========================
# 🧾 Logs
# =========================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Log files generated during runtime or errors

# =========================
# 🧠 Cache / Temporary Files
# =========================
.cache/
.tmp/
temp/
# Temporary files generated by tools

# =========================
# 🧪 Testing
# =========================
coverage/
# Code coverage reports (not needed in repo)

# =========================
# 🧩 IDE / Editor Files
# =========================
.vscode/
.idea/
*.swp
*.swo
# VS Code, IntelliJ settings and temp files

# =========================
# 💻 OS Files
# =========================
.DS_Store
Thumbs.db
# Mac & Windows system files

# =========================
# 🔑 SSL / Certificates
# =========================
*.pem
*.key
*.crt
# Security certificates (sensitive)

# =========================
# 🗄 Database Files (if local)
# =========================
*.sqlite
*.db
# Local DB files (never push)

# =========================
# 🧪 Misc
# =========================
*.pid
*.seed
# Process IDs or seed files

# =========================
# 📦 Package Lock (OPTIONAL)
# =========================
# package-lock.json
# Keep it for consistency usually (DO NOT ignore in most cases)

# =========================
# 🚀 Deployment Specific
# =========================
.vercel/
.netlify/
# Deployment platform configs

# =========================
# 🐳 Docker
# =========================
docker-compose.override.yml
# Local docker overrides

# =========================
# 🔥 Redis / Cache Dumps
# =========================
dump.rdb
# Redis database dump file